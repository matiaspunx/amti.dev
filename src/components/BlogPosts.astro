---
import { getCollection } from "astro:content";
import BlogPostLink from "./BlogPostLink.astro";
import SectionTitles from "./SectionTitles.astro";
const AllBlogPosts = await getCollection("blog", ({ data }) => {
  return data.isDraft !== true;
});
---

<section
  class="mt-12 grid grid-cols-1 gap-4 rounded-lg border border-indigo-700/70 p-5 md:mt-20 dark:border-indigo-700/20"
>
  <SectionTitles title="blog">Blog</SectionTitles>
  {AllBlogPosts.map((post) => <BlogPostLink post={post} />)}
</section>
