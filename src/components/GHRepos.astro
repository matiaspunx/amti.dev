---
import RepoCard from "./RepoCard.astro";
import { getLatestRepos } from "@/utils/github-functions";

const repos = await getLatestRepos();
---

<section>
  <nav
    class="mt-8 grid grid-cols-1 gap-4 rounded-lg border border-indigo-700/70 p-4 lg:grid-cols-3 dark:border-indigo-700/20"
  >
    {
      repos &&
        repos.map((repo: any, index) => <RepoCard repo={repo} index={index} />)
    }
  </nav>
</section>
