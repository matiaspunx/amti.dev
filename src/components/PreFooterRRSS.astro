---
import GithubIcon from "./icons/GithubIcon.astro";
import TwitchIcon from "./icons/TwitchIcon.astro";
import YoutubeIcon from "./icons/YoutubeIcon.astro";
---

<section class="mt-12 md:mt-20">
  <h2
    class="bg-gradient-to-r from-pink-100 via-purple-500 to-purple-900 bg-clip-text text-center font-mono text-2xl font-semibold text-transparent lg:text-4xl"
  >
    Me encuentran en
  </h2>
  <div
    class="mt-4 grid grid-cols-1 gap-4 rounded-lg border border-indigo-700/70 p-5 dark:border-indigo-700/20"
  >
    <div class="grid grid-cols-3 gap-x-2 md:gap-x-8">
      <a
        href="https://www.twitch.tv/amtidev"
        target="_blank"
        rel="noopener noreferrer"
        class="link-icon twitch"
        title="Twitch"
        aria-label="Enlace a mi Twitch"
      >
        <TwitchIcon class="icon" />
        <span>Twitch</span></a
      >
      <a
        href="https://github.com/matiaspunx"
        target="_blank"
        rel="noopener noreferrer"
        class="link-icon github"
        title="GitHub"
        aria-label="Enlace a mi GitHub"
      >
        <GithubIcon class="icon" />
        <span>GitHub</span></a
      >
      <a
        href="https://youtube.com/amtidev"
        target="_blank"
        rel="noopener noreferrer"
        class="link-icon youtube"
        title="YouTube"
        aria-label="Enlace a mi YouTube"
      >
        <YoutubeIcon class="icon" />
        <span>YouTube</span></a
      >
    </div>
  </div>
</section>
<style>
  .link-icon {
    @apply inline-flex flex-col items-center justify-center rounded-md bg-twitch px-2 py-2 text-white transition hover:scale-105 md:py-8;
  }
  .twitch {
    @apply bg-twitch;
  }
  .github {
    @apply bg-black;
  }
  .youtube {
    @apply bg-red-700;
  }
  .icon {
    @apply h-12 w-auto md:h-24;
  }
</style>
