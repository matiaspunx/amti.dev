---
import GithubIcon from "./icons/GithubIcon.astro";
import IconVerMas from "./icons/IconVerMas.astro";
const { repo, index } = Astro.props;

// Define un array de clases de fondo
const bgClasses = [
  "bg-purple-500",
  "bg-purple-600",
  "bg-purple-700",
  "bg-purple-800",
];

const bgHoverClasses = [
  "hover:bg-purple-600",
  "hover:bg-purple-700",
  "hover:bg-purple-800",
  "hover:bg-purple-900",
];

let bg = bgClasses[index % bgClasses.length];
let bgHover = bgHoverClasses[index % bgHoverClasses.length];
---

<a
  href={repo.url}
  target="_blank"
  rel="noopener noreferrer"
  class={`group flex flex-col items-start justify-between space-y-2 rounded-md ${bg} p-4 font-mono transition ${bgHover} shadow-xl hover:shadow-purple-700/20`}
>
  <div class="space-y-2">
    <h3 class="flex items-center gap-x-2 text-2xl font-bold text-white">
      <GithubIcon class="h-6 w-auto" />
      {repo.name}
    </h3>
    <p class="text-sm text-white">{repo.description}</p>
  </div>
  <span
    class="inline-flex items-center self-end text-base text-white hover:text-indigo-200"
    ><span>Visitar</span>
    <IconVerMas
      class="mt-0.5 h-4 w-auto transition group-hover:translate-x-1"
    />
  </span>
</a>
