---
interface Props {
  textColor?: string;
  bgColor?: string;
  duration?: string;
}

const {
  textColor = "text-white",
  bgColor = "bg-indigo-500",
  duration = "300",
} = Astro.props;
---

<span class="group relative inline-flex w-fit overflow-hidden">
  <span
    class=`absolute inset-0 origin-bottom scale-y-0 transform ${bgColor} transition-transform duration-${duration} ease-in-out group-hover:scale-y-100 group-hover:${bgColor}`
  ></span>
  <span
    class=`relative w-fit ${textColor} transition-colors duration-${duration} ease-in-out group-hover:text-white`
    ><slot /></span
  >
</span>
