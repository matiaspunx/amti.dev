---
import TextBgAppear from "@/components/TextBgAppear.astro";
import Layout from "./Layout.astro";
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<Layout title={title}>
  <header
    class="flex items-center justify-between border-b border-indigo-700/20 py-2"
  >
    <a href="/" class="font-mono text-3xl"><TextBgAppear>amti</TextBgAppear></a>
  </header>
  <slot />
</Layout>
