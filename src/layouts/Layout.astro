---
import Footer from "@/components/Footer.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title = "Amti" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      href="/fonts/Mona-Sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/IBMPlexMono-Regular.ttf" as="font" />
    <link rel="preload" href="/fonts/IBMPlexMono-Bold.ttf" as="font" />
    <link rel="preload" href="/fonts/IBMPlexMono-SemiBold.ttf" as="font" />
    <link rel="preload" href="/fonts/IBMPlexMono-Italic.ttf" as="font" />
    <link rel="preload" href="/fonts/IBMPlexMono-BoldItalic.ttf" as="font" />
    <link
      rel="preload"
      href="/fonts/IBMPlexMono-SemiBoldItalic.ttf"
      as="font"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="container mx-auto mt-4 lg:max-w-6xl">
      <main
        class="content-grid relative overflow-hidden before:absolute before:start-1/2 before:top-0 before:-z-[1] before:size-full before:-translate-x-1/4 before:-translate-y-3 before:transform before:bg-[url('/squared-bg-element.svg')] before:bg-top before:bg-no-repeat dark:before:bg-[url('/squared-bg-element-dark.svg')]"
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
<style is:global>
  :root {
    --color-primary: #ddd;
    --color-secondary: #333;
    --color-accent: #ed64a6;
    --color-accent-rgb: 213, 255, 0;

    --background-color: #141800;
    --background-twitch: var(--color-twitch-ice);

    --color-twitch: #9146ff;
    --color-twitch-ice: #f0f0ff;
    --color-twitch-ice-rgb: 240, 240, 255;

    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
    --bg-color: #111111;
    --color-gradient-1: #ed64a6;
    --color-gradient-2: #b794f4;
    --color-gradient-3: #ee4444;
  }
  @media (prefers-color-scheme: light) {
    :root {
      --bg-color: #f0f0f0;
    }
  }

  @font-face {
    font-family: "Mona Sans";
    src:
      url("/fonts/Mona-Sans.woff2") format("woff2 supports variations"),
      url("/fonts/Mona-Sans.woff2") format("woff2-variations");
    font-weight: 200 900;
    font-stretch: 75% 125%;
  }

  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/IBMPlexMono-Regular.ttf") format("truetype");
    font-weight: 400;
    font-stretch: 75% 125%;
  }

  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/IBMPlexMono-Bold.ttf") format("truetype");
    font-weight: 700;
    font-stretch: 75% 125%;
  }

  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/IBMPlexMono-SemiBold.ttf") format("truetype");
    font-weight: 600;
    font-stretch: 75% 125%;
  }

  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/IBMPlexMono-Italic.ttf") format("truetype");
    font-weight: 400;
    font-stretch: 75% 125%;
    font-style: italic;
  }

  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/IBMPlexMono-BoldItalic.ttf") format("truetype");
    font-weight: 700;
    font-stretch: 75% 125%;
    font-style: italic;
  }

  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/IBMPlexMono-SemiBoldItalic.ttf") format("truetype");
    font-weight: 600;
    font-stretch: 75% 125%;
    font-style: italic;
  }

  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/IBMPlexMono-Medium.ttf") format("truetype");
    font-weight: 500;
    font-stretch: 75% 125%;
  }

  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/IBMPlexMono-MediumItalic.ttf") format("truetype");
    font-weight: 500;
    font-stretch: 75% 125%;
    font-style: italic;
  }

  html {
    background-color: var(--bg-color);
    scroll-behavior: smooth;
    scrollbar-gutter: stable;

    line-height: 1.5;
    -webkit-text-size-adjust: 100%;
    tab-size: 4;
    font-family:
      ui-sans-serif,
      system-ui,
      sans-serif,
      "Apple Color Emoji",
      "Segoe UI Emoji",
      Segoe UI Symbol,
      "Noto Color Emoji";
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
    font-variation-settings: normal;
    -webkit-tap-highlight-color: transparent;
    min-height: 100vh;
  }

  @media (prefers-color-scheme: light) {
    html {
      background-color: var(--bg-color);
    }
  }

  body {
    &:has(dialog[open]) {
      overflow: hidden;
    }
  }

  body:has(.side-menu:checked),
  html:has(.side-menu:checked) {
    overflow: hidden;
  }

  /* Hiding class, making content visible only to screen readers but not visually */
  /* "sr" meaning "screen-reader" */
  .sr-only:not(:focus):not(:active) {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  @supports selector(::-webkit-scrollbar) {
    ::-webkit-scrollbar {
      width: 10px;
      border-radius: 10px;
    }

    ::-webkit-scrollbar-thumb {
      border-radius: 10px;
      /* background-color: theme("colors.primary"); */
      background-color: #33333390;
      border: 2px solid transparent;
      background-clip: content-box;
    }

    ::-webkit-scrollbar-thumb:active {
      background-color: #666;
    }

    ::-webkit-scrollbar-track {
      background: var(--background-image);
    }

    ::-webkit-scrollbar-corner {
      background: var(--background-image);
    }
  }

  @supports not selector(::-webkit-scrollbar) {
    * {
      scrollbar-color: theme("colors.primary") transparent;
      scrollbar-width: thin;
    }
  }

  @media (max-width: 540px) {
    @supports selector(::-webkit-scrollbar) {
      ::-webkit-scrollbar {
        display: none;
        width: 0;
      }
    }
  }

  .anchor-main-content {
    pointer-events: none;
  }

  .anchor-main-content:focus {
    pointer-events: all;
  }
  @media (prefers-color-scheme: dark) {
    .maskimage {
      mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
    }
  }

  .dark-bg-radial-gradient {
    background-image: radial-gradient(
      closest-side,
      rgba(76, 29, 149, 0.4),
      rgba(76, 29, 149, 0.1),
      transparent
    ) !important;
  }

  /* content grid */
  .content-grid {
    --padding-inline: 2rem;
    --content-max-width: 90ch;
    --breackout-max-width: 100ch;
    --breackout-size: calc(
      (var(--breackout-max-width) - var(--content-max-width)) / 2
    );

    display: grid;
    grid-template-columns:
      [full-width-start] minmax(var(--padding-inline), 1fr)
      [breackout-start] minmax(0, var(--breackout-size))
      [content-start] min(
        100% - (var(--padding-inline) * 2),
        var(--content-max-width)
      )
      [content-end]
      minmax(0, var(--breackout-size)) [breackout-end]
      minmax(var(--padding-inline), 1fr) [full-width-end];
  }

  .content-grid > :not(.breackout, .full-width) {
    grid-column: content;
  }

  .content-grid > .breackout {
    grid-column: breackout;
  }

  .content-grid > .full-width {
    grid-column: full-width;
  }
  /* end content grid */
</style>
